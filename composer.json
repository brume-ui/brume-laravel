{
    "name": "brume/laravel",
    "description": "Brume admin panel for Laravel (Inertia + React).",
    "type": "library",
    "homepage": "https://github.com/brume-ui/brume-laravel",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0.28"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "laravel/pint": "^1.18",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Brume\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brume\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Brume\\BrumeServiceProvider"
            ],
            "aliases": {
                "Brume": "Brume\\Facades\\Brume"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "sync-schema": "@php -r \"copy('frontend/node_modules/@brume-ui/brume-schema/schema/v0.json', 'resources/schema/v0.json') || exit(1);\"",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --port=8100 --ansi"
        ],
        "e2e": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm --dir e2e install --frozen-lockfile",
            "pnpm --dir e2e exec playwright test"
        ],
        "smoke": [
            "Composer\\Config::disableProcessTimeout",
            "bin/smoke-install.sh"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@build-frontend",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "build-frontend": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm --dir frontend install --frozen-lockfile",
            "pnpm --dir frontend build:workbench"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
